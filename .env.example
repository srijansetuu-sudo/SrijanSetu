# Copy this file to .env in the Project root.
# Keep real .env files private. They are ignored by git.

# Shared
APP_NAME=SrijanSetu API
ENVIRONMENT=local
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database (local development defaults)
POSTGRES_DB=srijansetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/srijansetu

# Authentication
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMISSION_PERCENT=15

# Uploads
UPLOAD_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET_NAME=
S3_REGION_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contact email notifications
CONTACT_RECIPIENT_EMAIL=srijan.setuu@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Robot/local test defaults
BASE_URL=http://127.0.0.1:8000
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=StrongCustomerPass123!
CREATOR_EMAIL=
CREATOR_PASSWORD=StrongCreatorPass123!
ADMIN_EMAIL=
ADMIN_PASSWORD=StrongAdminPass123!
